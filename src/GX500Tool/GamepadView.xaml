<UserControl x:Class="GX500Tool.GamepadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Pad" Width="640" Height="400">
            <!-- Body: GX500 silhouette with grips -->
            <Path Stroke="{StaticResource BorderBrush}" StrokeThickness="2"
                  Data="M 170,92 C 230,72 410,72 470,92 C 540,102 582,132 602,202 C 626,292 620,372 570,387 C 530,397 500,362 470,322 C 450,297 420,292 400,292 L 240,292 C 220,292 190,297 170,322 C 140,362 110,397 70,387 C 20,372 14,292 38,202 C 58,132 100,102 170,92 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1D1F3C" Offset="0"/>
                        <GradientStop Color="#121329" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Effect>
                    <DropShadowEffect Color="#7C3AED" BlurRadius="30" ShadowDepth="0" Opacity="0.35"/>
                </Path.Effect>
            </Path>
            <!-- Stick wells and d-pad base -->
            <Ellipse Canvas.Left="127" Canvas.Top="122" Width="96" Height="96" Fill="#0E0F22"/>
            <Ellipse Canvas.Left="346" Canvas.Top="201" Width="88" Height="88" Fill="#0E0F22"/>
            <Ellipse Canvas.Left="200" Canvas.Top="195" Width="100" Height="100" Fill="#0E0F22"/>
            <Ellipse Canvas.Left="410" Canvas.Top="110" Width="110" Height="110" Fill="#0E0F22"/>
        </Canvas>
    </Viewbox>
</UserControl>
