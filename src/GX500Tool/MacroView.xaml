<UserControl x:Class="GX500Tool.MacroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,6,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="+ Macro baru" Padding="8,3" Click="New_Click"/>
                <Button Content="Hapus" Padding="8,3" Margin="6,0,0,0" Click="Delete_Click"/>
            </StackPanel>
            <ListBox x:Name="MacroList" DisplayMemberPath="Name" SelectionChanged="MacroList_Changed"/>
        </DockPanel>

        <Grid Grid.Column="1" x:Name="Editor" IsEnabled="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <WrapPanel>
                <TextBlock Text="Nama" VerticalAlignment="Center"/>
                <TextBox x:Name="NameBox" Width="160" Margin="6,0,14,0"/>
                <TextBlock Text="Tombol pemicu" VerticalAlignment="Center"/>
                <ComboBox x:Name="TriggerCombo" Width="100" Margin="6,0,14,0"/>
                <TextBlock Text="Mode" VerticalAlignment="Center"/>
                <ComboBox x:Name="ModeCombo" Width="200" Margin="6,0,0,0"/>
            </WrapPanel>
            <TextBlock Grid.Row="1" Margin="0,8,0,4" TextWrapping="Wrap" Foreground="#AAA"
                       Text="Langkah: satu baris per langkah, format &quot;TOMBOL DURASI_MS&quot;. Contoh &quot;A+RB 80&quot; = tahan A dan RB 80 ms, &quot;- 50&quot; = jeda 50 ms. Nama tombol: A B X Y LB RB LT RT Back Start LS RS Guide Up Down Left Right Capture."/>
            <TextBox x:Name="StepsBox" Grid.Row="2" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                     Background="#15151A" Foreground="#B8F0B8"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="RecordButton" Content="● Rekam" Padding="10,3" Click="Record_Click"/>
                <Button Content="Simpan macro" Padding="10,3" Margin="6,0,0,0" Click="Save_Click"/>
                <TextBlock x:Name="MessageText" VerticalAlignment="Center" Margin="10,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
