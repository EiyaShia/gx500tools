<UserControl x:Class="GX500Tool.RemapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GX500Tool">
    <Grid Margin="6">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="StartButton" Content="▶ Aktifkan virtual controller" Style="{StaticResource AccentButton}" Click="Start_Click"/>
            <CheckBox x:Name="HideCheck" Margin="14,0,0,0" VerticalAlignment="Center" Click="HideCheck_Click"
                      Content="Sembunyikan controller asli saat aktif"
                      ToolTip="Mode Switch saja. Controller asli otomatis terlihat lagi saat virtual controller dimatikan atau app ditutup. Butuh izin admin (UAC)."/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0" Text="Nonaktif"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PadRow" Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ListRow" Height="0"/>
            </Grid.RowDefinitions>

            <GroupBox Header="Klik tombol untuk mengubahnya · tekan tombol di gamepad untuk menemukannya">
                <local:GamepadView x:Name="PadView" MinHeight="180"/>
            </GroupBox>

            <GroupBox Grid.Row="1" x:Name="EditorCard" Header="Tombol terpilih" IsEnabled="False">
                <WrapPanel>
                    <Border Background="{StaticResource AccentGradient}" CornerRadius="8" Padding="12,4" MinWidth="60" Margin="0,0,14,0">
                        <TextBlock x:Name="SelLabel" Text="—" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Output" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="SelTarget" Width="150" SelectionChanged="SelTarget_Changed"/>
                    <CheckBox x:Name="SelTurbo" Content="Turbo" VerticalAlignment="Center" Margin="14,0" Click="SelTurbo_Click"/>
                    <Button Content="Kembalikan ke asli" Click="SelReset_Click"/>
                </WrapPanel>
            </GroupBox>

            <CheckBox Grid.Row="2" x:Name="ShowListCheck" Content="Tampilkan daftar semua tombol" Margin="10,2,0,4" Click="ShowList_Click"/>

            <GroupBox Grid.Row="3" Header="Semua tombol  (Tombol fisik → Output · Turbo)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="MapGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="80"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Tipe gamepad">
                    <StackPanel>
                        <RadioButton x:Name="TypeXbox" GroupName="padtype" Margin="0,3" Click="Type_Click"
                                     Content="Xbox  ·  A B X Y"/>
                        <RadioButton x:Name="TypePlayStation" GroupName="padtype" Margin="0,3" Click="Type_Click"
                                     Content="PlayStation  ·  ✕ ○ □ △"/>
                        <TextBlock x:Name="TypeHint" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Turbo">
                    <StackPanel>
                        <TextBlock x:Name="TurboLabel"/>
                        <Slider x:Name="TurboSlider" Minimum="2" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Deadzone analog">
                    <StackPanel>
                        <TextBlock x:Name="LdzLabel"/>
                        <Slider x:Name="LdzSlider" Minimum="0" Maximum="40"/>
                        <TextBlock x:Name="RdzLabel"/>
                        <Slider x:Name="RdzSlider" Minimum="0" Maximum="40"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Profil">
                    <StackPanel>
                        <Button Content="Reset semua ke default" Padding="6,3" Click="Reset_Click"/>
                        <TextBlock x:Name="ProfilePath" TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Catatan">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#BBB"
                               Text="Gunakan mode Switch untuk hasil terbaik (ada gyro dan controller asli bisa disembunyikan). Di mode X-Input, game bisa melihat 2 controller."/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
