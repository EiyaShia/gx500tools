<UserControl x:Class="GX500Tool.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,6,0">
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button Content="+ Baru" Padding="8,3" Click="New_Click"/>
                <Button Content="Duplikat" Padding="8,3" Margin="6,0,0,0" Click="Duplicate_Click"/>
                <Button Content="Hapus" Padding="8,3" Margin="6,0,0,0" Click="Delete_Click"/>
            </WrapPanel>
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="#AAA" TextWrapping="Wrap"
                       Text="Klik profil untuk mengaktifkannya. Semua tab lain mengedit profil yang aktif."/>
            <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_Changed"/>
        </DockPanel>

        <StackPanel Grid.Column="1">
            <GroupBox Header="Profil aktif">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="NameBox" Width="200"/>
                        <Button Content="Ganti nama" Padding="8,2" Margin="6,0,0,0" Click="Rename_Click"/>
                    </StackPanel>
                    <TextBlock Margin="0,10,0,4" TextWrapping="Wrap"
                               Text="Game yang memakai profil ini (nama file .exe, satu per baris):"/>
                    <TextBox x:Name="ProcessBox" Height="90" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Simpan daftar game" Padding="8,2" Click="SaveProcesses_Click"/>
                        <Button x:Name="AddLastButton" Padding="8,2" Margin="6,0,0,0" Click="AddLast_Click"/>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#888" TextWrapping="Wrap"
                               Text="Tip: buka game-nya, lalu kembali ke sini dan klik tombol tambah. App mencatat game terakhir yang aktif."/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Pengaturan app">
                <StackPanel>
                    <CheckBox x:Name="AutoSwitchCheck" Foreground="#E6E6EA" Margin="0,3" Click="Settings_Click"
                              Content="Ganti profil otomatis sesuai game yang sedang aktif"/>
                    <CheckBox x:Name="AutoStartCheck" Foreground="#E6E6EA" Margin="0,3" Click="Settings_Click"
                              Content="Aktifkan virtual controller otomatis saat app dibuka"/>
                    <CheckBox x:Name="WindowsStartCheck" Foreground="#E6E6EA" Margin="0,3" Click="WindowsStart_Click"
                              Content="Jalankan saat Windows mulai (langsung ke tray)"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
