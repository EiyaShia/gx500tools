<UserControl x:Class="GX500Tool.GyroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E6E6EA"/><Setter Property="Margin" Value="0,3"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#E6E6EA"/><Setter Property="Margin" Value="0,2"/></Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.ColumnSpan="2" Margin="6" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1">
            <GroupBox Header="Output gyro">
                <StackPanel>
                    <RadioButton x:Name="OutOff" Content="Mati" GroupName="out" Click="Output_Click"/>
                    <RadioButton x:Name="OutMouse" Content="Mouse (aim di game PC / mouse+keyboard)" GroupName="out" Click="Output_Click"/>
                    <RadioButton x:Name="OutStick" Content="Analog kanan (game yang hanya baca controller)" GroupName="out" Click="Output_Click"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Kapan gyro aktif">
                <StackPanel>
                    <RadioButton x:Name="ActAlways" Content="Selalu aktif" GroupName="act" Click="Activation_Click"/>
                    <RadioButton x:Name="ActHold" Content="Hanya saat tombol ditahan" GroupName="act" Click="Activation_Click"/>
                    <RadioButton x:Name="ActToggle" Content="Tekan tombol untuk on/off" GroupName="act" Click="Activation_Click"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Tombol: " VerticalAlignment="Center"/>
                        <ComboBox x:Name="ButtonCombo" Width="120" SelectionChanged="ButtonCombo_Changed"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Kalibrasi">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="Letakkan gamepad diam di meja, lalu klik tombol di bawah. Ini menghilangkan drift (kursor bergerak sendiri)."/>
                    <Button x:Name="CalibButton" Content="Kalibrasi gyro (2 detik)" Padding="8,3" Margin="0,6,0,0" Click="Calibrate_Click"/>
                    <TextBlock x:Name="CalibText" Margin="0,4,0,0" Foreground="#AAA"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <GroupBox Header="Sensitivitas &amp; arah">
                <StackPanel>
                    <TextBlock x:Name="MouseSensLabel"/>
                    <Slider x:Name="MouseSens" Minimum="1" Maximum="80"/>
                    <TextBlock x:Name="StickSensLabel"/>
                    <Slider x:Name="StickSens" Minimum="0.2" Maximum="4"/>
                    <CheckBox x:Name="InvertX" Content="Balik arah horizontal" Click="Check_Click"/>
                    <CheckBox x:Name="InvertY" Content="Balik arah vertikal" Click="Check_Click"/>
                    <CheckBox x:Name="UseRoll" Content="Horizontal pakai miring kiri/kanan (roll), bukan putar (yaw)" Click="Check_Click"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Kehalusan">
                <StackPanel>
                    <TextBlock x:Name="DeadzoneLabel"/>
                    <Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="10"/>
                    <TextBlock x:Name="SmoothLabel"/>
                    <Slider x:Name="SmoothSlider" Minimum="0" Maximum="0.9"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Live">
                <TextBlock x:Name="LiveText" FontFamily="Consolas"/>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
